{
  "name": "tsukinowa-business-system",
  "private": true,
  "scripts": {
    "test": "node tests/static-and-sw.cjs && node --test tests/onoda-repair.cjs tests/test-data-cleanup.cjs && node --test tests/historical-import.cjs tests/outstanding.cjs tests/year-end.cjs tests/cloud-core.cjs tests/standalone-receipt.cjs tests/set-tsukinowa-claims.cjs tests/estimate-calendar.cjs tests/business-workflow.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tsukinowa \"node --test tests/firestore-rules.cjs\"",
    "test:browser": "node tests/onoda-browser.cjs && node tests/navigation.cjs && node tests/calendar-sync.cjs && node tests/cloud-browser.cjs",
    "test:business-browser": "firebase emulators:exec --only firestore --project demo-tsukinowa \"node tests/business-browser.cjs\"",
    "test:outstanding-browser": "firebase emulators:exec --only firestore --project demo-tsukinowa \"node tests/outstanding-browser.cjs\"",
    "test:historical-browser": "firebase emulators:exec --only firestore --project demo-tsukinowa \"node tests/historical-import-browser.cjs\"",
    "claims:tsukinowa": "node scripts/set-tsukinowa-claims.cjs",
    "test:auth-persistence": "node tests/auth-persistence.cjs",
    "test:document-numbering-browser": "firebase emulators:exec --only firestore --project demo-tsukinowa \"node tests/document-numbering-browser.cjs\"",
    "test:business-workflow": "node --test tests/business-workflow.cjs && node tests/business-workflow-browser.cjs",
    "test:estimate-calendar": "node --test tests/estimate-calendar.cjs && node tests/estimate-calendar-browser.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.19.0",
    "firebase-admin": "13.6.0",
    "firebase-tools": "15.11.0",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
